	-- Phát nhạc

	function playItem(item)
		if closed then
			return
		end
		stopPlayback()

		local asset = assetOf(item.audio)
		if asset == "" then
			setStatus("Không đọc được file audio: " .. item.title, COLOR.err)
			refreshList()
			return
		end

		local sound = Instance.new("Sound")
		sound.Name = "KhangHubPlayer"
		sound.SoundId = asset
		sound.Volume = 1
		sound.Parent = SoundService

		sound.Ended:Connect(function()
			if currentSound == sound then
				stopPlayback()
				setStatus("Phát xong: " .. item.title, COLOR.ok)
				refreshList()
			end
		end)

		currentSound = sound
		currentId = item.id
		sound:Play()

		setStatus("Đang phát: " .. item.title, COLOR.ok)
		refreshList()
	end

	function deleteItem(item)
		if currentId == item.id then
			stopPlayback()
		end

		for index, entry in ipairs(library) do
			if entry.id == item.id then
				table.remove(library, index)
				break
			end
		end

		if typeof(delfile) == "function" then
			pcall(delfile, item.audio)
			if item.thumb ~= "" then
				pcall(delfile, item.thumb)
			end
		end

		assetCache[item.audio] = nil
		if item.thumb ~= "" then
			assetCache[item.thumb] = nil
		end
		thumbPaths[item.id] = nil

		saveIndex(library)
		setStatus("Đã xóa: " .. item.title)
		refreshList()
	end

	-- Tải audio rồi phát ngay

	function downloadAndPlay(videoId, fallbackTitle)
		if closed then
			return
		end

		local existing = findLibraryItem(videoId)
		if existing then
			playItem(existing)
			return
		end

		if not canRun then
			setStatus("Thiếu hàm executor: " .. missingText, COLOR.err)
			return
		end
		if busy then
			setStatus("Đang tải một bài khác, đợi xong đã.", COLOR.err)
			return
		end

		busy = true
		busyId = videoId
		setStatus("Đang tải âm thanh, có thể mất vài chục giây...")
		refreshList()

		task.spawn(function()
			local ok, body, apiTitle = fetchAudio(videoId)
			busy = false
			busyId = nil

			if closed then
				return
			end
			if not ok then
				setStatus(body, COLOR.err)
				refreshList()
				return
			end

			local audioPath = AUDIO_DIR .. "/" .. videoId .. ".mp3"
			if not pcall(writefile, audioPath, body) then
				setStatus("Không ghi được file audio vào thư mục executor.", COLOR.err)
				refreshList()
				return
			end

			local item = {
				id = videoId,
				title = apiTitle or fallbackTitle or ("YouTube " .. videoId),
				audio = audioPath,
				thumb = thumbPaths[videoId] or "",
			}
			table.insert(library, 1, item)
			saveIndex(library)
			playItem(item)
			requestThumb(videoId)
		end)
	end

	-- Tìm kiếm YouTube qua Invidious

	function runSearch(query, append)
		if closed then
			return
		end
		if not canRun then
			setStatus("Thiếu hàm executor: " .. missingText, COLOR.err)
			return
		end
		if searching then
			return
		end

		searchSeq = searchSeq + 1
		local seq = searchSeq
		searching = true

		local page = 1
		if append then
			page = nextPage or 1
			setStatus("Đang tải thêm kết quả...")
		else
			searchResults = {}
			nextPage = nil
			currentQuery = query
			setStatus("Đang tìm \"" .. query .. "\"...")
		end
		refreshList()

		task.spawn(function()
			local ok, result, hasMore = invidiousSearch(query, page)
			if closed or seq ~= searchSeq then
				return
			end
			searching = false

			if not ok then
				setStatus(result, COLOR.err)
				refreshList()
				return
			end

			local seen = {}
			for _, entry in ipairs(searchResults) do
				seen[entry.id] = true
			end
			for _, entry in ipairs(result) do
				if not seen[entry.id] then
					seen[entry.id] = true
					table.insert(searchResults, entry)
				end
			end
			nextPage = hasMore and (page + 1) or nil

			if #searchResults == 0 then
				setStatus("Không có video nào cho \"" .. currentQuery .. "\".")
			else
				setStatus("Tìm thấy " .. #searchResults .. " video cho \"" .. currentQuery .. "\".", COLOR.ok)
			end
			refreshList()
		end)
	end

	function setMode(mode)
		currentMode = mode
		applyTabStyles()
		refreshList()
	end

	local function handleSubmit()
		if closed then
			return
		end
		local text = urlInput.Text
		local videoId = extractId(text)
		if videoId then
			downloadAndPlay(videoId, nil)
			return
		end

		local query = text:match("^%s*(.-)%s*$") or ""
		if query == "" then
			setStatus("Nhập từ khóa hoặc dán link YouTube.", COLOR.err)
			return
		end
		setMode("search")
		runSearch(query, false)
	end

	-- Giao diện

	local function applyTheme(index, animate)
		currentTheme = index
		local accent = THEMES[index].accent
		local info = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

		for i = #themed, 1, -1 do
			local entry = themed[i]
			if entry.obj:IsDescendantOf(gui) then
				if entry.role == "grad" then
					entry.obj.Color = ColorSequence.new(darken(accent, 0.55), COLOR.header)
				elseif animate then
					TweenService:Create(entry.obj, info, { [entry.prop] = accent }):Play()
				else
					entry.obj[entry.prop] = accent
				end
			else
				table.remove(themed, i)
			end
		end

		urlStroke.Color = COLOR.border
		for i, entry in ipairs(themeDots) do
			entry.ring.Transparency = i == index and 0 or 1
		end

		themeTitle.Text = "GIAO DIỆN · " .. THEMES[index].name:upper()
		applyTabStyles()
		refreshList()
	end

	local OPEN_INFO = TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	local CLOSE_INFO = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

	local function setOpen(open)
		if open == isOpen then
			return
		end
		isOpen = open

		if open then
			if closeConn then
				closeConn:Disconnect()
				closeConn = nil
			end
			bubble.Visible = false
			main.Visible = true
			mainScale.Scale = 0.6
			TweenService:Create(mainScale, OPEN_INFO, { Scale = 1 }):Play()
		else
			if closeConn then
				closeConn:Disconnect()
			end
			local tween = TweenService:Create(mainScale, CLOSE_INFO, { Scale = 0.6 })
			closeConn = tween.Completed:Connect(function(state)
				closeConn = nil
				if not isOpen and state == Enum.PlaybackState.Completed then
					main.Visible = false
					mainScale.Scale = 1
					bubble.Visible = true
					bubbleScale.Scale = 0.4
					TweenService:Create(bubbleScale, OPEN_INFO, { Scale = 1 }):Play()
				end
			end)
			tween:Play()
		end
	end

	local function destroyApp()
		if closed then
			return
		end
		closed = true
		stopPlayback()
		if closeConn then
			closeConn:Disconnect()
			closeConn = nil
		end
		for _, conn in ipairs(connections) do
			conn:Disconnect()
		end
		gui:Destroy()
	end

	-- Sự kiện

	actionBtn.MouseButton1Click:Connect(handleSubmit)

	table.insert(connections, urlInput:GetPropertyChangedSignal("Text"):Connect(function()
		actionBtn.Text = extractId(urlInput.Text) and "TẢI & PHÁT" or "TÌM"
	end))

	urlInput.Focused:Connect(function()
		urlStroke.Color = THEMES[currentTheme].accent
		urlStroke.Transparency = 0
	end)

	urlInput.FocusLost:Connect(function(enterPressed)
		urlStroke.Color = COLOR.border
		urlStroke.Transparency = 0.4
		if enterPressed then
			handleSubmit()
		end
	end)

	tabSearch.MouseButton1Click:Connect(function()
		if currentMode ~= "search" then
			setMode("search")
		end
	end)

	tabSaved.MouseButton1Click:Connect(function()
		if currentMode ~= "saved" then
			setMode("saved")
		end
	end)

	for index, entry in ipairs(themeDots) do
		entry.button.MouseButton1Click:Connect(function()
			if index ~= currentTheme then
				applyTheme(index, true)
				saveSettings(index)
			end
		end)
	end

	minBtn.MouseButton1Click:Connect(function()
		setOpen(false)
	end)

	closeBtn.MouseButton1Click:Connect(destroyApp)

	table.insert(connections, UserInputService.InputBegan:Connect(function(inp, processed)
		if processed then
			return
		end
		if inp.KeyCode == Enum.KeyCode.RightControl then
			setOpen(not isOpen)
		end
	end))

	makeDraggable(header, main, connections)
	makeDraggable(bubble, bubble, connections, function()
		setOpen(true)
	end)

	-- Khởi tạo: GUI hiện trước, dữ liệu nạp sau một nhịp

	applyTheme(currentTheme, false)
	applyTabStyles()
	setStatus("Đang khởi tạo...")

	task.defer(function()
		if closed then
			return
		end

		if canRun then
			ensureFolders()
			library = loadIndex()
			for _, item in ipairs(library) do
				if item.thumb ~= "" then
					thumbPaths[item.id] = item.thumb
				end
			end
			local settings = loadSettings()
			if type(settings.theme) == "number" and THEMES[settings.theme] then
				currentTheme = settings.theme
			end
		end

		applyTheme(currentTheme, false)

		if not canRun then
			setStatus("Thiếu hàm executor: " .. missingText, COLOR.err)
		else
			setStatus("Sẵn sàng. Nhập từ khóa hoặc dán link YouTube.", COLOR.ok)
		end
	end)
end

