local function makeDraggable(handle, target, bag, onTap)
	local dragging = false
	local moved = false
	local dragStart = nil
	local startPos = nil

	table.insert(bag, handle.InputBegan:Connect(function(inp)
		if inp.UserInputType ~= Enum.UserInputType.MouseButton1
			and inp.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		dragging = true
		moved = false
		dragStart = inp.Position
		startPos = target.Position

		local endConn
		endConn = inp.Changed:Connect(function()
			if inp.UserInputState == Enum.UserInputState.End then
				endConn:Disconnect()
				dragging = false
				if not moved and onTap then
					onTap()
				end
			end
		end)
	end))

	table.insert(bag, UserInputService.InputChanged:Connect(function(inp)
		if not dragging then
			return
		end
		if inp.UserInputType ~= Enum.UserInputType.MouseMovement
			and inp.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local delta = inp.Position - dragStart
		if not moved and delta.Magnitude < DRAG_THRESHOLD then
			return
		end
		moved = true
		target.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end))
end

local function getHeader(headers, name)
	if type(headers) ~= "table" then
		return nil
	end
	local target = name:lower()
	for key, value in pairs(headers) do
		if tostring(key):lower() == target then
			return value
		end
	end
	return nil
end

local function percentDecode(text)
	text = text:gsub("%+", " ")
	return (text:gsub("%%(%x%x)", function(hex)
		return string.char(tonumber(hex, 16))
	end))
end

local function percentEncode(text)
	local encoded = text:gsub("[^%w%-_%.~ ]", function(c)
		return string.format("%%%02X", string.byte(c))
	end)
	return (encoded:gsub(" ", "+"))
end

local ENTITIES = { amp = "&", lt = "<", gt = ">", quot = '"', apos = "'", nbsp = " " }

local function decodeEntities(text)
	text = text:gsub("&#(%d+);", function(n)
		local ok, ch = pcall(utf8.char, tonumber(n))
		return ok and ch or ""
	end)
	text = text:gsub("&#x(%x+);", function(h)
		local ok, ch = pcall(utf8.char, tonumber(h, 16))
		return ok and ch or ""
	end)
	text = text:gsub("&(%a+);", function(name)
		return ENTITIES[name] or ("&" .. name .. ";")
	end)
	return text
end

local function formatDuration(seconds)
	seconds = math.max(0, math.floor(tonumber(seconds) or 0))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return ("%d:%02d:%02d"):format(h, m, s)
	end
	return ("%d:%02d"):format(m, s)
end

local function extractId(url)
	if type(url) ~= "string" then
		return nil
	end
	local id = url:match("[?&]v=([%w_%-]+)")
		or url:match("youtu%.be/([%w_%-]+)")
		or url:match("youtube%.com/shorts/([%w_%-]+)")
		or url:match("youtube%.com/embed/([%w_%-]+)")
		or url:match("youtube%.com/live/([%w_%-]+)")
	if id and #id >= 6 then
		return id
	end
	return nil
end

