	-- Thumbnail: cache theo id, tải song song có giới hạn luồng

	local function onThumbReady(id, path)
		thumbPaths[id] = path
		for _, entry in ipairs(library) do
			if entry.id == id and entry.thumb == "" then
				entry.thumb = path
				saveIndex(library)
			end
		end
		local slots = thumbSlots[id]
		thumbSlots[id] = nil
		if slots then
			local asset = assetOf(path)
			for _, label in ipairs(slots) do
				if label.Parent then
					label.Image = asset
				end
			end
		end
	end

	local function runThumbJob(job)
		local ok, path = pcall(fetchThumb, job.id)
		thumbPending[job.id] = nil
		if ok and path and not closed then
			pcall(onThumbReady, job.id, path)
		end
		thumbRunning = thumbRunning - 1
		pumpThumbs()
	end

	function pumpThumbs()
		if closed then
			return
		end
		while thumbRunning < THUMB_WORKERS and #thumbQueue > 0 do
			local job = table.remove(thumbQueue, 1)
			thumbRunning = thumbRunning + 1
			task.spawn(runThumbJob, job)
		end
	end

	local function requestThumb(id)
		if closed or thumbPaths[id] or thumbPending[id] then
			return
		end
		thumbPending[id] = true
		table.insert(thumbQueue, { id = id })
		pumpThumbs()
	end

	local function setThumbSlot(id, label)
		local path = thumbPaths[id]
		if path then
			label.Image = assetOf(path)
			return
		end
		thumbSlots[id] = thumbSlots[id] or {}
		table.insert(thumbSlots[id], label)
		requestThumb(id)
	end

