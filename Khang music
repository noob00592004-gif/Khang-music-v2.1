local function loadIndex()
	if not isfile(INDEX_PATH) then
		return {}
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(INDEX_PATH))
	end)
	local list = {}
	if not ok or type(data) ~= "table" then
		return list
	end
	for _, entry in ipairs(data) do
		if type(entry) == "table"
			and type(entry.id) == "string"
			and type(entry.audio) == "string"
			and isfile(entry.audio)
		then
			local thumb = ""
			if type(entry.thumb) == "string" and entry.thumb ~= "" and isfile(entry.thumb) then
				thumb = entry.thumb
			end
			table.insert(list, {
				id = entry.id,
				title = type(entry.title) == "string" and entry.title or entry.id,
				audio = entry.audio,
				thumb = thumb,
			})
		end
	end
	return list
end

local function saveIndex(list)
	pcall(writefile, INDEX_PATH, HttpService:JSONEncode(list))
end

