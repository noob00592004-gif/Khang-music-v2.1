local assetCache = {}

local function assetOf(path)
	if type(path) ~= "string" or path == "" then
		return ""
	end
	if assetCache[path] then
		return assetCache[path]
	end
	if not isfile(path) then
		return ""
	end
	local ok, asset = pcall(getcustomasset, path)
	if ok and asset then
		assetCache[path] = asset
		return asset
	end
	return ""
end

-- Tìm kiếm qua Invidious: thử lần lượt các instance, nhớ instance chạy được gần nhất

local preferredInstance = nil

local function invidiousSearch(query, page)
	local order = {}
	if preferredInstance then
		table.insert(order, preferredInstance)
	end
	for _, base in ipairs(INVIDIOUS_INSTANCES) do
		if base ~= preferredInstance then
			table.insert(order, base)
		end
	end

	for _, base in ipairs(order) do
		local url = base .. "/api/v1/search?type=video&q=" .. percentEncode(query) .. "&page=" .. tostring(page)
		local ok, res = pcall(httpRequest, {
			Url = url,
			Method = "GET",
			Headers = { ["Accept"] = "application/json" },
		})

		if ok and type(res) == "table" and res.StatusCode == 200 and type(res.Body) == "string" then
			local okJson, data = pcall(function()
				return HttpService:JSONDecode(res.Body)
			end)
			if okJson and type(data) == "table" and data.error == nil then
				preferredInstance = base

				local results = {}
				for _, item in ipairs(data) do
					if type(item) == "table" and item.type == "video" and type(item.videoId) == "string" then
						table.insert(results, {
							id = item.videoId,
							title = decodeEntities(tostring(item.title or item.videoId)),
							channel = decodeEntities(tostring(item.author or "")),
							duration = tonumber(item.lengthSeconds) or 0,
						})
					end
				end
				return true, results, #data > 0
			end
		end
	end

	return false, ERR_TEXT.search_failed
end

-- Tải audio qua dịch vụ đang dùng

local function fetchAudio(videoId)
	local payload = HttpService:JSONEncode({
		url = "https://www.youtube.com/watch?v=" .. videoId,
		format = "mp3",
		response = "file",
	})

	local attempt = 0
	while attempt < 3 do
		attempt += 1

		local ok, res = pcall(httpRequest, {
			Url = AUDIO_API_URL,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
				["X-Client-Name"] = APP_NAME,
			},
			Body = payload,
		})

		if not ok or type(res) ~= "table" then
			return false, "Không kết nối được API. Kiểm tra mạng rồi thử lại."
		end

		if res.StatusCode == 200 and type(res.Body) == "string" and #res.Body > 0 then
			local rawTitle = getHeader(res.Headers, "X-Samplecut-Title")
			local title = nil
			if type(rawTitle) == "string" and rawTitle ~= "" then
				title = percentDecode(rawTitle)
			end
			return true, res.Body, title
		end

		if res.StatusCode == 429 then
			local wait = tonumber(getHeader(res.Headers, "Retry-After")) or 60
			return false, ("Hết lượt gọi API. Thử lại sau %d giây."):format(wait)
		end

		local message = "Lỗi HTTP " .. tostring(res.StatusCode)
		local okJson, decoded = pcall(HttpService.JSONDecode, HttpService, res.Body or "")
		if okJson and type(decoded) == "table" and type(decoded.error) == "table" then
			local code = decoded.error.code
			message = ERR_TEXT[code] or decoded.error.message or message
		end

		if res.StatusCode == 502 and attempt < 3 then
			task.wait(attempt * 2)
		else
			return false, message
		end
	end

	return false, "Hết số lần thử lại."
end

-- Tải thumbnail, bỏ qua nếu file đã có trong cache

local function fetchThumb(videoId)
	local path = THUMB_DIR .. "/" .. videoId .. ".jpg"
	if isfile(path) then
		return path
	end
	local ok, res = pcall(httpRequest, {
		Url = THUMB_URL:format(videoId),
		Method = "GET",
	})
	if not ok or type(res) ~= "table" or res.StatusCode ~= 200 then
		return nil
	end
	if type(res.Body) ~= "string" or #res.Body == 0 then
		return nil
	end
	if pcall(writefile, path, res.Body) then
		return path
	end
	return nil
end

